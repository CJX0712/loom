# 默认按文本处理，仓库内一律存 LF
* text=auto eol=lf

# Windows 批处理必须是 CRLF，否则 cmd 会读出乱码
*.bat text eol=crlf
*.cmd text eol=crlf

# Shell 脚本必须保持 LF，否则在 Linux/macOS 上无法执行
*.sh text eol=lf

# 二进制文件不参与换行转换
*.png binary
*.jpg binary
*.ico binary
*.gif binary
*.woff binary
*.woff2 binary
*.pdf binary

# 让 GitHub 语言统计别把 HTML/CSS 算成主要语言
static/index.html linguist-vendored=false
